{
  "name": "elentrik",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.15.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @elentrik/web dev",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:migrate": "pnpm --filter @elentrik/web db:migrate",
    "test": "pnpm test:parallel && pnpm test:prestatie",
    "test:parallel": "vitest run --exclude \"**/*prestatie*.test.ts\"",
    "test:prestatie": "vitest run prestatie --no-file-parallelism",
    "typecheck": "pnpm -r typecheck",
    "voorbeeld": "tsx scripts/voorbeeld-schema.ts",
    "voorbeeld:print": "tsx scripts/voorbeeld-print.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
