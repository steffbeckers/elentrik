BETTER_AUTH_SECRET=<vervang-door-een-lange-willekeurige-waarde>
BETTER_AUTH_URL=http://127.0.0.1:3000

# Het e-mailadres van de boekhouding, dat een kopie van elke betaalde factuur krijgt; leeg laten voor geen kopie.
BOEKHOUDING_INBOX=

DATABASE_URL=postgres://elentrik:elentrik@127.0.0.1:5432/elentrik

ELENTRIK_BESTANDEN_DIR=.data/bestanden
ELENTRIK_GOTENBERG_URL=http://127.0.0.1:3001

SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_VAN="Elentrik <noreply@elentrik.local>"
# Optioneel, voor een echte mailserver; lokaal (Mailpit) weglaten: dan geen aanmelding en geen TLS.
# SMTP_GEBRUIKER=<gebruikersnaam>
# SMTP_WACHTWOORD=<wachtwoord>
# true: TLS vanaf het begin van de verbinding (meestal poort 465).
# SMTP_BEVEILIGD=true

# Abonnementen met Stripe. Zonder STRIPE_GEHEIME_SLEUTEL zijn abonnementen uit (geen proefperiode, geen beperkingen).
# De geheime sleutel van Stripe (sk_test_... of sk_live_...).
STRIPE_GEHEIME_SLEUTEL=
# Het geheim van het webhook-eindpunt in Stripe (whsec_...).
STRIPE_WEBHOOK_GEHEIM=
# Het id van de maandprijs in Stripe (price_...).
STRIPE_PRIJS_MAAND=
# Het id van de jaarprijs in Stripe (price_...).
STRIPE_PRIJS_JAAR=
# Alleen voor tests: een lokale nep-Stripe (alleen 127.0.0.1 of localhost, en alleen met een sk_test_-sleutel).
STRIPE_API_BASIS=
# De geplande taken (de uurlijkse inhaaltaak voor gemiste Stripe-meldingen) draaien standaard alleen in productie.
# aan: ze ook lokaal laten draaien; uit: ze nooit laten draaien (de e2e-server zet dit zelf).
# ELENTRIK_GEPLANDE_TAKEN=uit

# Online (achter de Cloudflare Tunnel op de NAS); lokaal weglaten.
# Het subnet van het Docker-netwerk waaruit de tunnel verzoeken doorgeeft (CIDR). Alleen voor verzoeken
# uit dit subnet geldt cf-connecting-ip als IP van de bezoeker; zonder deze variabele telt het IP van de socket.
# ELENTRIK_VERTROUWD_PROXYNET=<cidr>
# smtp (standaard) of graph (Microsoft Graph); graph vraagt de vier variabelen hieronder.
# MAIL_VERZENDER=smtp
# GRAPH_TENANT_ID=<tenant-id>
# GRAPH_CLIENT_ID=<client-id>
# GRAPH_CLIENT_GEHEIM=<client-geheim>
# Het adres waarmee Graph mail verstuurt.
# MAIL_AFZENDER=<afzenderadres>

# De omgeving (alleen op de NAS): productie of staging. Leeg of weggelaten (lokaal, e2e): geen balk, geen
# titelvoorvoegsel, geen noindex. Bij staging weigert de server MAIL_VERZENDER=graph en een sleutel
# sk_live_...; bij productie SMTP_HOST=mailpit. Eén variabele: de client krijgt de waarde van de server.
# ELENTRIK_OMGEVING=staging
