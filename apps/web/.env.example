DATABASE_URL=postgres://elentrik:elentrik@127.0.0.1:5432/elentrik
ELENTRIK_BESTANDEN_DIR=.data/bestanden
ELENTRIK_GOTENBERG_URL=http://127.0.0.1:3001
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_VAN="Elentrik <noreply@elentrik.local>"
# Optioneel, voor een echte mailserver; lokaal (Mailpit) weglaten: dan geen aanmelding en geen TLS.
# SMTP_GEBRUIKER=<gebruikersnaam>
# SMTP_WACHTWOORD=<wachtwoord>
# true: TLS vanaf het begin van de verbinding (meestal poort 465).
# SMTP_BEVEILIGD=true
BETTER_AUTH_SECRET=<vervang-door-een-lange-willekeurige-waarde>
BETTER_AUTH_URL=http://127.0.0.1:3000

# Abonnementen met Stripe. Zonder STRIPE_GEHEIME_SLEUTEL zijn abonnementen uit (geen proefperiode, geen beperkingen).
# De geheime sleutel van Stripe (sk_test_... of sk_live_...).
STRIPE_GEHEIME_SLEUTEL=
# Het geheim van het webhook-eindpunt in Stripe (whsec_...).
STRIPE_WEBHOOK_GEHEIM=
# Het id van de maandprijs in Stripe (price_...).
STRIPE_PRIJS_MAAND=
# Het id van de jaarprijs in Stripe (price_...).
STRIPE_PRIJS_JAAR=
# Het e-mailadres van de boekhouding, dat een kopie van elke betaalde factuur krijgt; leeg laten voor geen kopie.
BOEKHOUDING_INBOX=
# Alleen voor tests: een lokale nep-Stripe (alleen 127.0.0.1 of localhost, en alleen met een sk_test_-sleutel).
STRIPE_API_BASIS=
