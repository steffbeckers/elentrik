{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@elentrik/web", "dev"],
      "port": 3000,
      "url": "http://127.0.0.1:3000"
    },
    {
      "name": "web-controle",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@elentrik/web", "exec", "nuxt", "dev", "--port", "3300", "--host", "127.0.0.1"],
      "env": {
        "DATABASE_URL": "postgres://elentrik:elentrik@127.0.0.1:5432/elentrik_e2e",
        "ELENTRIK_BESTANDEN_DIR": ".data/e2e-bestanden",
        "ELENTRIK_BUILD_DIR": ".nuxt-e2e",
        "BETTER_AUTH_URL": "http://127.0.0.1:3300",
        "NUXT_AUTH_BASIS_URL": "http://127.0.0.1:3300"
      },
      "port": 3300,
      "url": "http://127.0.0.1:3300"
    },
    {
      "name": "web-controle-corepack",
      "runtimeExecutable": "C:\\Program Files\\nodejs\\pnpm.cmd",
      "runtimeArgs": ["--filter", "@elentrik/web", "exec", "nuxt", "dev", "--port", "3300", "--host", "127.0.0.1"],
      "env": {
        "DATABASE_URL": "postgres://elentrik:elentrik@127.0.0.1:5432/elentrik_e2e",
        "ELENTRIK_BESTANDEN_DIR": ".data/e2e-bestanden",
        "ELENTRIK_BUILD_DIR": ".nuxt-e2e",
        "BETTER_AUTH_URL": "http://127.0.0.1:3300",
        "NUXT_AUTH_BASIS_URL": "http://127.0.0.1:3300"
      },
      "port": 3300,
