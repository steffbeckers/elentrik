  "narrative": {
    "northStar": "Existing Nuxt UI blue/slate interface",
    "overview": "Elentrik uses a restrained application interface: blue actions, slate neutrals, compact sans text, Lucide icons, thin separators, and focused forms. This is a record of the incumbent implementation, not a new visual identity or a claim about production deployment.\n\nThe admin area extends that system with linked records, horizontally scrollable tables, and explicit correction controls. The electrical editor retains its own dense toolbars and drawing surface. Page-specific composition remains in the surface brief; it is not a product-wide layout rule.",
    "keyCharacteristics": [
      "Semantic colours preserve light and dark themes.",
      "Compact hierarchy and labelled controls support operational work.",
      "Borders and tonal surfaces supply structure; floating results can use shadows."
    ],
    "rules": [
      {
        "name": "The Semantic Theme Rule",
        "body": "Use the existing semantic colour roles for UI surfaces, text, rules, and interaction states.",
        "section": "colors"
      },
      {
        "name": "The Structural Depth Rule",
        "body": "Follow existing component depth: bordered content surfaces and elevated floating results.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic Nuxt UI colours so light and dark modes stay connected.",
      "Do preserve visible labels, focus feedback, and the three supported interface languages.",
      "Do reuse existing component variants and Lucide icons.",
      "Do preserve readable table columns through local horizontal scrolling."
    ],
    "donts": [
      "Don't hard-code a light-only palette in shared components.",
      "Don't apply the comfortable-form control minimum to every editor toolbar.",
      "Don't turn admin-specific composition into a rule for every product screen."
    ]
  }
