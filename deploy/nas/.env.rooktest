# Alleen niet-geheime testwaarden voor deploy/nas/rooktest.sh. Niet voor gebruik op de NAS.
# ELENTRIK_DATA en ELENTRIK_IMAGE zet het script zelf (een tijdelijke map en het net gebouwde image).

ELENTRIK_UID=1026
ELENTRIK_GID=100

POSTGRES_WACHTWOORD=rooktest-db-wachtwoord

BETTER_AUTH_SECRET=rooktest-geheim-alleen-voor-de-rooktest-0123456789
# De rooktest opent de app op de poort die hij zelf publiceert.
BETTER_AUTH_URL=http://127.0.0.1:3399
NUXT_AUTH_BASIS_URL=http://127.0.0.1:3000

# De lokale Mailpit (infra/docker-compose.yml) op de host; het script leest de mail via 127.0.0.1:8025.
SMTP_HOST=host.docker.internal
SMTP_PORT=1025
SMTP_VAN=Elentrik rooktest <noreply@rooktest.elentrik.test>

# Geen uurlijkse inhaaltaak tijdens de rooktest.
ELENTRIK_GEPLANDE_TAKEN=uit
