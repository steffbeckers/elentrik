# Kopieer dit bestand naar `.env` naast compose.yaml en vul het in. Het echte `.env` bevat geheimen:
# zet het nooit in git of in een screenshot. Hieronder staan alleen plaatshouders.

# ---- De NAS -----------------------------------------------------------------------------------
# De map waaronder de gegevens staan; ze bevat drie submappen die je vooraf aanmaakt:
#   postgres/   de database (niet meenemen in Hyper Backup: gebruik de dumps)
#   bestanden/  de geüploade plannen, logo's en exports
#   backups/    de nachtelijke dumps (meenemen in Hyper Backup)
ELENTRIK_DATA=/volume1/docker/elentrik
# De gebruiker en groep waaronder de app en de back-up draaien. Die gebruiker moet schrijven in
# bestanden/ en backups/ (op Synology: `id <gebruiker>` in een SSH-sessie).
ELENTRIK_UID=1026
ELENTRIK_GID=100
# Welk image: standaard `latest`; pin een korte commit-SHA om een versie vast te zetten.
# ELENTRIK_IMAGE=ghcr.io/steffbeckers/elentrik-web:latest

# ---- Database ---------------------------------------------------------------------------------
# Het wachtwoord van de databasegebruiker `elentrik`. Gebruik alleen letters en cijfers: het gaat
# letterlijk in een URL (DATABASE_URL). Het wordt bij de eerste start van de database vastgelegd.
POSTGRES_WACHTWOORD=<vervang-door-een-lange-willekeurige-waarde>

# ---- Aanmelden en adres -----------------------------------------------------------------------
# Het geheim voor sessies en tokens: minstens 32 tekens, een nieuwe willekeurige waarde, nooit
# hergebruikt van elders. Wijzigen logt iedereen uit.
BETTER_AUTH_SECRET=<vervang-door-een-lange-willekeurige-waarde>
# Het publieke adres van de app (zonder slash op het einde). Mails en cookies gebruiken dit.
BETTER_AUTH_URL=https://elentrik.app
# Het adres waarmee de server zichzelf aanspreekt tijdens het renderen van pagina's. Binnen de
# container altijd dit, niet het publieke adres.
NUXT_AUTH_BASIS_URL=http://127.0.0.1:3000

# ---- E-mail -----------------------------------------------------------------------------------
# smtp (standaard) of graph (Microsoft Graph).
MAIL_VERZENDER=graph
# Voor graph: de app-registratie in Entra ID met de toepassingsmachtiging Mail.Send, en de mailbox
# waarmee verstuurd wordt.
GRAPH_TENANT_ID=<tenant-id>
GRAPH_CLIENT_ID=<client-id>
GRAPH_CLIENT_GEHEIM=<client-geheim>
MAIL_AFZENDER=noreply@elentrik.app
# Voor smtp: de mailserver. Alleen invullen als MAIL_VERZENDER=smtp.
# SMTP_HOST=<mailserver>
# SMTP_PORT=587
# SMTP_VAN="Elentrik <noreply@elentrik.app>"
# SMTP_GEBRUIKER=<gebruikersnaam>
# SMTP_WACHTWOORD=<wachtwoord>
# true: TLS vanaf het begin van de verbinding (meestal poort 465).
# SMTP_BEVEILIGD=true

# ---- Abonnementen (Stripe); leeg laten voor geen abonnementen ----------------------------------
# De geheime sleutel van Stripe (sk_test_... of sk_live_...). Is hij gezet, dan zijn de drie volgende verplicht.
STRIPE_GEHEIME_SLEUTEL=
# Het geheim van het webhook-eindpunt https://elentrik.app/api/stripe/webhook (whsec_...).
STRIPE_WEBHOOK_GEHEIM=
# De id's van de maand- en jaarprijs in Stripe (price_...).
STRIPE_PRIJS_MAAND=
STRIPE_PRIJS_JAAR=
# Het adres van de boekhouding, dat een kopie van elke betaalde factuur krijgt; leeg voor geen kopie.
BOEKHOUDING_INBOX=

# ---- Noodstop ---------------------------------------------------------------------------------
# uit: de uurlijkse inhaaltaak voor gemiste Stripe-meldingen doet niets. Weglaten voor gewoon gebruik.
# ELENTRIK_GEPLANDE_TAKEN=uit
